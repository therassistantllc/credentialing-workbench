{
  "name": "credentialing-workbench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:source",
    "test:unit": "vitest run",
    "test:source": "node --test tests/node/*.mjs",
    "test:e2e": "playwright test",
    "verify:phase1": "node --experimental-strip-types scripts/phase1-verification.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "server-only": "0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "latest",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "latest",
    "tsx": "latest"
  }
}
